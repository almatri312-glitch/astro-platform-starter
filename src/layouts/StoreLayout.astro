---
import '../styles/globals.css';
import Navbar from '../components/store/Navbar.astro';
import StoreFooter from '../components/store/StoreFooter.astro';
import CartWrapper from '../components/store/CartWrapper';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mocha · Authentic Yemeni Coffee',
  description = 'The world\'s rarest single-origin coffee from the highlands of Khawlan, Yemen.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body style="background:#FAF7F2; color:#1A0F00;">
    <CartWrapper client:load />
    <Navbar />
    <main><slot /></main>
    <StoreFooter />
  </body>
</html>
