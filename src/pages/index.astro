---
import StoreLayout from '../layouts/StoreLayout.astro';
import Hero from '../components/store/Hero.astro';
import ProductCard from '../components/store/ProductCard.astro';
import StorySection from '../components/store/StorySection.astro';
import OriginsSection from '../components/store/OriginsSection.astro';
import TestimonialsSection from '../components/store/TestimonialsSection.astro';
import { getFeaturedProducts } from '../data/products';

const featured = getFeaturedProducts();
---

<StoreLayout>
  <Hero />

  <!-- Thin divider -->
  <div style="height:1px; background:linear-gradient(90deg,transparent,rgba(26,15,0,0.1),transparent);"></div>

  <!-- Collection -->
  <section class="py-28" style="background:#FAF7F2;">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">

      <div class="flex items-end justify-between mb-14">
        <div>
          <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#9B7A50; margin-bottom:0.75rem;">The Collection</p>
          <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(2rem,4vw,3rem); font-weight:300; color:#1A0F00; line-height:1.1;">
            Shop the <em style="font-style:italic; color:#8B6914;">Collection</em>
          </h2>
        </div>
        <a href="/products" class="no-underline hidden sm:inline-flex"
          style="font-size:0.6rem; font-weight:600; letter-spacing:0.2em; text-transform:uppercase; color:#9B7A50; border-bottom:1px solid rgba(26,15,0,0.2); padding-bottom:2px; transition:color 0.2s;">
          View All →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <StorySection />

  <!-- Process -->
  <section class="py-28" style="background:#FAF7F2;">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="text-center mb-16 space-y-4">
        <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#9B7A50;">The Journey</p>
        <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(2.2rem,4vw,3.2rem); font-weight:300; color:#1A0F00; line-height:1.1;">
          From Tree <em style="font-style:italic; color:#8B6914;">to Cup</em>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          { step: '01', title: 'Natural Farming', desc: 'Traditional, chemical-free methods passed through generations.', icon: '◈' },
          { step: '02', title: 'Hand Picked', desc: 'Every cherry selected at peak ripeness for maximum flavour.', icon: '◈' },
          { step: '03', title: 'Small-Batch Roasted', desc: 'Expert roasters, small batches, every single day.', icon: '◈' },
          { step: '04', title: 'Shipped Fresh', desc: 'Within 24h of roasting, sealed for peak freshness.', icon: '◈' },
        ].map((item) => (
          <div class="space-y-4" style="border-top:2px solid rgba(26,15,0,0.08); padding-top:1.5rem;">
            <p style="font-size:0.6rem; letter-spacing:0.2em; color:#9B7A50; font-weight:500;">{item.step}</p>
            <h3 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.3rem; font-weight:400; color:#1A0F00;">{item.title}</h3>
            <p style="font-size:0.85rem; font-weight:300; color:#5C3D1E; line-height:1.8;">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <OriginsSection />
  <TestimonialsSection />

  <!-- Final CTA -->
  <section class="py-32" style="background:#1A0F00;">
    <div class="max-w-2xl mx-auto px-6 text-center space-y-8">
      <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#8B6914;">Ready?</p>
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(2.5rem,6vw,4rem); font-weight:300; color:#F5E0B0; line-height:1.1;">
        Taste <em style="font-style:italic; color:#C8963E;">Real</em><br />Yemeni Coffee.
      </h2>
      <p style="font-size:0.9rem; font-weight:300; color:#9B7A50; line-height:1.8;">
        Free shipping on your first order. 100% satisfaction guarantee.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href="/products/al-khawlani" class="no-underline"
          style="display:inline-flex; align-items:center; padding:1.1rem 3rem; font-size:0.65rem; font-weight:600; letter-spacing:0.25em; text-transform:uppercase; background:#F5E0B0; color:#1A0F00; transition:opacity 0.3s;">
          Shop Al-Khawlani
        </a>
        <a href="/#story" class="no-underline"
          style="display:inline-flex; align-items:center; padding:1.1rem 3rem; font-size:0.65rem; font-weight:600; letter-spacing:0.25em; text-transform:uppercase; background:transparent; color:#F5E0B0; border:1px solid rgba(245,224,176,0.2); transition:opacity 0.3s;">
          Our Story
        </a>
      </div>
    </div>
  </section>
</StoreLayout>
