---
---

<footer style="background:#1A0F00; color:#F5E0B0;">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">

      <!-- Brand -->
      <div class="space-y-4">
        <div>
          <p style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.4rem; font-weight:400; letter-spacing:0.15em; color:#F5E0B0;">MOCHA</p>
          <p style="font-size:0.5rem; letter-spacing:0.3em; color:#9B7A50; margin-top:2px; text-transform:uppercase;">Yemeni Coffee</p>
        </div>
        <p style="font-size:0.85rem; font-weight:300; color:#9B7A50; line-height:1.8;">
          Bringing the finest single-origin Yemeni coffee directly from highland farmers to your door.
        </p>
        <div class="flex gap-3 pt-2">
          {['IG', 'X', 'WA'].map((s) => (
            <a href="#" class="no-underline transition-opacity hover:opacity-60"
              style="font-size:0.55rem; letter-spacing:0.15em; color:#9B7A50; font-weight:500; border:1px solid rgba(245,224,176,0.1); padding:6px 10px;">
              {s}
            </a>
          ))}
        </div>
      </div>

      <!-- Links -->
      <div class="space-y-4">
        <p style="font-size:0.55rem; letter-spacing:0.25em; text-transform:uppercase; color:#9B7A50; font-weight:500;">Navigate</p>
        <ul class="space-y-3">
          {[['Home','/'],['Shop','/products'],['Our Story','/#story'],['Contact','#']].map(([l,h]) => (
            <li><a href={h} class="no-underline transition-opacity hover:opacity-60" style="font-size:0.85rem; font-weight:300; color:#F5E0B0;">{l}</a></li>
          ))}
        </ul>
      </div>

      <!-- Coffees -->
      <div class="space-y-4">
        <p style="font-size:0.55rem; letter-spacing:0.25em; text-transform:uppercase; color:#9B7A50; font-weight:500;">Our Coffees</p>
        <ul class="space-y-3">
          {[
            ['Al-Khawlani · Now','/products/al-khawlani'],
            ['Haraz Dark · Soon','#'],
            ['Mocha Blend · Soon','#'],
          ].map(([l,h]) => (
            <li><a href={h} class="no-underline transition-opacity hover:opacity-60" style="font-size:0.85rem; font-weight:300; color:#F5E0B0;">{l}</a></li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="space-y-4">
        <p style="font-size:0.55rem; letter-spacing:0.25em; text-transform:uppercase; color:#9B7A50; font-weight:500;">Stay in the Know</p>
        <p style="font-size:0.85rem; font-weight:300; color:#9B7A50; line-height:1.7;">New arrivals, origin stories, and exclusive offers.</p>
        <div class="flex">
          <input type="email" placeholder="your@email.com"
            style="flex:1; min-width:0; padding:0.7rem 1rem; font-size:0.75rem; background:rgba(245,224,176,0.05); border:1px solid rgba(245,224,176,0.1); color:#F5E0B0; outline:none;"/>
          <button style="padding:0.7rem 1.2rem; font-size:0.55rem; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; background:#8B6914; color:#FAF7F2; border:none; cursor:pointer; white-space:nowrap;">
            Join
          </button>
        </div>
      </div>
    </div>

    <div style="height:1px; background:rgba(245,224,176,0.08); margin-bottom:2rem;"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p style="font-size:0.6rem; color:rgba(245,224,176,0.3); letter-spacing:0.1em;">© 2024 Mocha Coffee. All rights reserved.</p>
      <div class="flex gap-6">
        {['Privacy','Terms','Returns'].map((l) => (
          <a href="#" class="no-underline transition-opacity hover:opacity-60" style="font-size:0.6rem; color:rgba(245,224,176,0.3); letter-spacing:0.1em;">{l}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
