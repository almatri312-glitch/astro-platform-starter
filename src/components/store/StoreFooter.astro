---
---

<footer class="relative pt-20 pb-8 border-t" style="border-color: rgba(200,150,62,0.15); background: rgba(10,5,0,0.8);">
  <div class="absolute inset-0 opacity-10" style="background-image: url('/images/noise.png');"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-16">

      <!-- Brand -->
      <div class="lg:col-span-1 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
            style="background: linear-gradient(135deg, #c8963e, #e8c47a);">
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none">
              <path d="M8 12h16l-2 12H10L8 12z" fill="#160b02"/>
              <path d="M6 12h20" stroke="#160b02" stroke-width="2" stroke-linecap="round"/>
              <path d="M24 16c2 0 4-1 4-3s-2-3-4-3" stroke="#160b02" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <span class="text-2xl font-black text-gradient">MOCHA</span>
            <p class="text-[10px] text-mocha-300 tracking-widest font-medium">YEMENI COFFEE</p>
          </div>
        </div>
        <p class="text-mocha-200 text-sm leading-relaxed" style="font-weight: 300;">
          Bringing the finest single-origin Yemeni coffee directly from highland farmers to your door.
        </p>
        <!-- Social -->
        <div class="flex gap-3">
          {['ig', 'tw', 'wa'].map((social) => (
            <a href="#" class="w-9 h-9 rounded-lg flex items-center justify-center transition-all no-underline hover:-translate-y-0.5"
              style="background: rgba(44,21,3,0.8); border: 1px solid rgba(200,150,62,0.2);" aria-label={social}>
              {social === 'ig' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c8963e" stroke-width="2" stroke-linecap="round">
                  <rect x="2" y="2" width="20" height="20" rx="5"/>
                  <circle cx="12" cy="12" r="5"/>
                  <circle cx="17.5" cy="6.5" r="1" fill="#c8963e" stroke="none"/>
                </svg>
              )}
              {social === 'tw' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="#c8963e">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {social === 'wa' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="#c8963e">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h4 class="font-black text-cream text-sm tracking-wide uppercase">Quick Links</h4>
        <ul class="space-y-2.5">
          {[
            { label: 'Home', href: '/' },
            { label: 'Shop', href: '/products' },
            { label: 'Our Story', href: '/#story' },
            { label: 'Contact', href: '#' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-mocha-200 hover:text-gold text-sm transition-colors no-underline font-medium">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Products -->
      <div class="space-y-4">
        <h4 class="font-black text-cream text-sm tracking-wide uppercase">Our Coffees</h4>
        <ul class="space-y-2.5">
          {[
            { label: 'Al-Khawlani · Available Now', href: '/products/al-khawlani' },
            { label: 'Haraz Dark · Coming Soon', href: '#' },
            { label: 'Mocha Blend · Coming Soon', href: '#' },
          ].map((link) => (
            <li>
              <a href={link.href} class="text-mocha-200 hover:text-gold text-sm transition-colors no-underline font-medium">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="space-y-4">
        <h4 class="font-black text-cream text-sm tracking-wide uppercase">Contact</h4>
        <div class="space-y-3">
          {[
            { icon: '📧', text: 'hello@mocha-coffee.com' },
            { icon: '📱', text: '+1 (555) XXX-XXXX' },
            { icon: '🕐', text: 'Mon–Fri, 9am – 6pm' },
          ].map((item) => (
            <div class="flex items-start gap-2">
              <span class="text-base flex-shrink-0">{item.icon}</span>
              <span class="text-sm text-mocha-200 font-medium">{item.text}</span>
            </div>
          ))}
        </div>
        <!-- Newsletter -->
        <div class="mt-4">
          <p class="text-xs text-mocha-300 mb-2">Get updates & exclusive offers</p>
          <div class="flex gap-2">
            <input type="email" placeholder="your@email.com"
              class="flex-1 min-w-0 px-3 py-2 rounded-lg text-xs"
              style="background: rgba(44,21,3,0.6); border: 1px solid rgba(200,150,62,0.2); color: #f5e0b0; outline: none;"/>
            <button class="px-3 py-2 rounded-lg text-xs font-bold flex-shrink-0"
              style="background: linear-gradient(135deg, #c8963e, #e8c47a); color: #0a0500;">
              Join
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="gold-divider mb-8"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-mocha-400 text-xs">© 2024 Mocha Coffee. All rights reserved.</p>
      <div class="flex items-center gap-4">
        {['Privacy Policy', 'Terms', 'Returns'].map((link) => (
          <a href="#" class="text-mocha-400 hover:text-mocha-200 text-xs transition-colors no-underline">{link}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
