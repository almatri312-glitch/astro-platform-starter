---
const items = [
  { icon: '🌱', title: '100% Organic', desc: 'No pesticides, ever' },
  { icon: '✋', title: 'Hand Picked', desc: 'At peak ripeness' },
  { icon: '🔥', title: 'Small-Batch Roasted', desc: 'Fresh daily' },
  { icon: '📦', title: 'Ships in 24h', desc: 'Post-roast' },
  { icon: '🤝', title: 'Fair Trade', desc: 'Direct from farmers' },
  { icon: '⭐', title: '4.9 / 5 Stars', desc: '300+ reviews' },
];
---

<div class="py-8 border-y" style="background: rgba(22,11,2,0.6); border-color: rgba(200,150,62,0.12);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-5">
      {items.map((item) => (
        <div class="flex flex-col items-center text-center gap-1.5 group">
          <span class="text-2xl group-hover:scale-110 transition-transform duration-200">{item.icon}</span>
          <p class="font-black text-cream text-xs tracking-wide">{item.title}</p>
          <p class="text-mocha-300 text-[11px]">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</div>
