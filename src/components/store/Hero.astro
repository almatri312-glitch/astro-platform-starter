---
---

<section class="relative min-h-screen flex items-center overflow-hidden -mt-16 sm:-mt-20">
  <!-- Background -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 60% 50%, #2c1503 0%, #0a0500 60%, #050200 100%);"></div>
  <div class="absolute inset-0 opacity-25" style="background-image: url('/images/noise.png');"></div>

  <!-- Glowing orbs -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl opacity-20"
    style="background: radial-gradient(circle, #c8963e 0%, transparent 70%);"></div>
  <div class="absolute bottom-1/3 right-1/4 w-64 h-64 rounded-full blur-3xl opacity-10"
    style="background: radial-gradient(circle, #e8c47a 0%, transparent 70%);"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-24 pb-16">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Text -->
      <div class="space-y-8">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border text-xs font-bold tracking-widest"
          style="border-color: rgba(200,150,62,0.4); background: rgba(200,150,62,0.08); color: #e8c47a;">
          <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
          Now Available · Al-Khawlani Single Origin
        </div>

        <!-- Headline -->
        <div class="space-y-2">
          <h1 class="font-black leading-tight" style="font-size: clamp(2.8rem, 7vw, 5rem); color: #f5e0b0; line-height: 1.1;">
            Yemen's Finest
            <br />
            <span class="text-gradient">Coffee, Delivered.</span>
          </h1>
          <p class="text-mocha-100 text-lg sm:text-xl leading-relaxed max-w-xl" style="font-weight: 300;">
            From the ancient highlands of Khawlan — hand-picked, naturally processed,
            and roasted in small batches to preserve every note of wild complexity.
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a href="/products/al-khawlani" class="btn btn-gold btn-lg no-underline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
            </svg>
            Shop Al-Khawlani
          </a>
          <a href="/#story" class="btn btn-outline btn-lg no-underline">Our Story</a>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-10 pt-2">
          {[
            { num: '5,000+', label: 'Happy Customers' },
            { num: '4', label: 'Yemen Regions' },
            { num: '100%', label: 'Natural & Organic' },
          ].map((stat) => (
            <div>
              <div class="text-2xl sm:text-3xl font-black text-gold">{stat.num}</div>
              <div class="text-xs text-mocha-200 font-medium mt-0.5">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Visual -->
      <div class="flex items-center justify-center lg:justify-end">
        <div class="relative float-anim">
          <div class="absolute inset-0 rounded-full blur-2xl opacity-40"
            style="background: radial-gradient(circle, #c8963e 0%, transparent 70%); transform: scale(1.3);"></div>

          <div class="relative w-72 h-72 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-full overflow-hidden shadow-2xl"
            style="background: linear-gradient(145deg, #2c1503 0%, #7a3d0a 40%, #c8963e 80%, #e8c47a 100%); border: 2px solid rgba(232,196,122,0.3);">
            <div class="absolute inset-4 rounded-full"
              style="background: linear-gradient(145deg, #160b02 0%, #3d1e05 60%, #7a3d0a 100%); border: 1px solid rgba(200,150,62,0.2);"></div>

            <!-- Coffee cup SVG -->
            <div class="absolute inset-0 flex items-center justify-center">
              <svg viewBox="0 0 120 120" width="145" height="145" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M45 35 Q48 25 45 15 Q42 5 45 0" stroke="#e8c47a" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.6"/>
                <path d="M60 38 Q63 28 60 18 Q57 8 60 3" stroke="#e8c47a" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.9"/>
                <path d="M75 35 Q78 25 75 15 Q72 5 75 0" stroke="#e8c47a" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.6"/>
                <path d="M30 50 L35 95 Q35 100 40 100 L80 100 Q85 100 85 95 L90 50 Z" fill="#c8963e" opacity="0.9"/>
                <rect x="26" y="46" width="68" height="8" rx="4" fill="#e8c47a"/>
                <path d="M85 60 Q105 60 105 75 Q105 90 85 90" stroke="#e8c47a" stroke-width="5" stroke-linecap="round" fill="none"/>
                <ellipse cx="60" cy="50" rx="33" ry="6" fill="#3d1e05" opacity="0.8"/>
                <ellipse cx="58" cy="50" rx="20" ry="3.5" fill="#2c1503" opacity="0.6"/>
                <path d="M50 50 Q60 44 70 50" stroke="#e8c47a" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.5"/>
                <circle cx="60" cy="50" r="4" fill="#c8963e" opacity="0.4"/>
                <ellipse cx="60" cy="103" rx="40" ry="6" fill="#a05415" opacity="0.8"/>
                <ellipse cx="60" cy="103" rx="35" ry="4" fill="#7a3d0a" opacity="0.6"/>
                <ellipse cx="42" cy="112" rx="5" ry="3" fill="#5c2e08" transform="rotate(-20 42 112)"/>
                <line x1="42" y1="109" x2="42" y2="115" stroke="#3d1e05" stroke-width="1" transform="rotate(-20 42 112)"/>
                <ellipse cx="78" cy="112" rx="5" ry="3" fill="#5c2e08" transform="rotate(20 78 112)"/>
                <line x1="78" y1="109" x2="78" y2="115" stroke="#3d1e05" stroke-width="1" transform="rotate(20 78 112)"/>
              </svg>
            </div>

            {[
              { x: '15%', y: '20%', size: '8px', delay: '0s' },
              { x: '80%', y: '15%', size: '6px', delay: '0.5s' },
              { x: '85%', y: '70%', size: '10px', delay: '1s' },
              { x: '10%', y: '75%', size: '7px', delay: '1.5s' },
            ].map((s) => (
              <div class="absolute rounded-full bg-gold animate-pulse"
                style={`left: ${s.x}; top: ${s.y}; width: ${s.size}; height: ${s.size}; animation-delay: ${s.delay}; opacity: 0.6;`} />
            ))}
          </div>

          <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap px-5 py-2 rounded-full font-bold text-xs shadow-xl"
            style="background: linear-gradient(135deg, #c8963e, #e8c47a); color: #0a0500;">
            ☕ Roasted Fresh Daily
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-xs text-mocha-200 font-medium tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-gold to-transparent"></div>
  </div>
</section>
