---
---

<section class="relative min-h-screen flex flex-col items-center justify-center text-center overflow-hidden -mt-16 sm:-mt-20"
  style="background: #FAF7F2;">

  <!-- Very subtle warm gradient center -->
  <div class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 60%, rgba(200,150,62,0.06) 0%, transparent 65%);"></div>

  <!-- Thin decorative top line -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(26,15,0,0.12), transparent);"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 py-40 flex flex-col items-center gap-10">

    <!-- Eyebrow -->
    <p style="font-size:0.6rem; font-weight:500; letter-spacing:0.45em; text-transform:uppercase; color:#9B7A50;">
      Yemen &nbsp;·&nbsp; Est. 500+ Years &nbsp;·&nbsp; Single Origin
    </p>

    <!-- Main headline -->
    <div class="space-y-0">
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(4.5rem,14vw,10rem); font-weight:300; color:#1A0F00; line-height:0.9; letter-spacing:-0.01em;">
        Where <em style="font-style:italic; color:#8B6914;">Coffee</em>
      </h1>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(4.5rem,14vw,10rem); font-weight:300; color:#1A0F00; line-height:0.9; letter-spacing:-0.01em;">
        Began.
      </h1>
    </div>

    <!-- Italic subtitle -->
    <p style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(1.1rem,2.5vw,1.5rem); font-style:italic; font-weight:300; color:#9B7A50; margin-top:0.5rem;">
      The world's rarest single origin.
    </p>

    <!-- Thin divider -->
    <div style="width:40px; height:1px; background:rgba(139,105,20,0.4);"></div>

    <!-- Body -->
    <p class="max-w-lg" style="font-size:0.95rem; font-weight:300; color:#5C3D1E; line-height:1.9;">
      Before Ethiopia. Before Colombia. Before Brazil —
      Yemeni farmers in the ancient mountains of Khawlan
      were brewing the very first cup.
      Now it arrives at your door.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/products/al-khawlani" class="no-underline"
        style="display:inline-flex; align-items:center; padding:1rem 2.8rem; font-size:0.65rem; font-weight:600; letter-spacing:0.25em; text-transform:uppercase; background:#1A0F00; color:#FAF7F2; transition:all 0.3s ease;">
        Shop Now
      </a>
      <a href="/#story" class="no-underline"
        style="display:inline-flex; align-items:center; padding:1rem 2.8rem; font-size:0.65rem; font-weight:600; letter-spacing:0.25em; text-transform:uppercase; background:transparent; color:#1A0F00; border:1px solid rgba(26,15,0,0.25); transition:all 0.3s ease;">
        Our Story
      </a>
    </div>

    <!-- Stats -->
    <div class="flex flex-wrap items-center justify-center gap-12 pt-10 mt-4 w-full max-w-lg"
      style="border-top:1px solid rgba(26,15,0,0.08);">
      {[
        { num: '500+', label: 'Years of Heritage' },
        { num: '2,200m', label: 'Altitude Grown' },
        { num: '100%', label: 'Natural Process' },
      ].map((stat) => (
        <div class="text-center">
          <div style="font-family:'Cormorant Garamond',Georgia,serif; font-size:2rem; font-weight:300; color:#1A0F00; line-height:1;">
            {stat.num}
          </div>
          <div style="font-size:0.55rem; letter-spacing:0.25em; text-transform:uppercase; color:#9B7A50; margin-top:5px; font-weight:500;">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
    <div style="width:1px; height:40px; background:linear-gradient(to bottom, transparent, rgba(26,15,0,0.2));"></div>
    <p style="font-size:0.55rem; letter-spacing:0.35em; text-transform:uppercase; color:rgba(26,15,0,0.3);">Scroll</p>
  </div>
</section>
