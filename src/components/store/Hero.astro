---
---

<section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden -mt-16 sm:-mt-20 text-center">

  <!-- Deep background -->
  <div class="absolute inset-0" style="background: #0e0805;"></div>

  <!-- Subtle vignette -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 40%, rgba(92,46,8,0.35) 0%, transparent 65%);"></div>

  <!-- Noise grain -->
  <div class="absolute inset-0 opacity-30" style="background-image: url('/images/noise.png');"></div>

  <!-- Very faint center glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full blur-3xl opacity-10"
    style="background: radial-gradient(circle, #c8963e 0%, transparent 70%);"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-6 py-32 flex flex-col items-center gap-8">

    <!-- Eyebrow -->
    <p class="text-xs tracking-[0.4em] uppercase font-medium" style="color: #a05415; letter-spacing: 0.35em;">
      Yemen &nbsp;·&nbsp; Est. 500+ Years
    </p>

    <!-- Main heading -->
    <h1 class="leading-none" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(4rem, 12vw, 8.5rem); font-weight: 300; color: #f5e0b0; line-height: 0.95;">
      Where <em style="font-style: italic; color: #c8963e;">Coffee</em><br />Began.
    </h1>

    <!-- Italic subtitle -->
    <p style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.2rem, 3vw, 1.7rem); font-style: italic; font-weight: 300; color: rgba(232,196,122,0.7);">
      The world's rarest single origin.
    </p>

    <!-- Divider -->
    <div class="w-16 h-px" style="background: linear-gradient(90deg, transparent, #c8963e, transparent);"></div>

    <!-- Body text -->
    <p class="max-w-xl leading-relaxed" style="font-size: 1rem; font-weight: 300; color: rgba(245,224,176,0.55); line-height: 1.8;">
      Before Ethiopia. Before Colombia. Before Brazil —
      Yemeni farmers in the ancient highlands of Khawlan were cultivating
      the very first cup. Now it arrives at your door.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <a href="/products/al-khawlani" class="no-underline"
        style="display: inline-flex; align-items: center; justify-content: center; padding: 1rem 2.5rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; background: #c8963e; color: #0a0500; transition: all 0.3s ease;">
        Shop Now
      </a>
      <a href="/#story" class="no-underline"
        style="display: inline-flex; align-items: center; justify-content: center; padding: 1rem 2.5rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; background: transparent; color: #c8963e; border: 1px solid rgba(200,150,62,0.4); transition: all 0.3s ease;">
        Our Story
      </a>
    </div>

    <!-- Stats -->
    <div class="flex flex-wrap items-center justify-center gap-12 pt-8 mt-4 border-t w-full max-w-lg"
      style="border-color: rgba(200,150,62,0.1);">
      {[
        { num: '500+', label: 'Years of Heritage' },
        { num: '2,200m', label: 'Altitude Grown' },
        { num: '100%', label: 'Natural Process' },
      ].map((stat) => (
        <div class="text-center">
          <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.8rem; font-weight: 300; color: #c8963e; line-height: 1;">
            {stat.num}
          </div>
          <div style="font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(160,84,21,0.8); margin-top: 4px; font-weight: 500;">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
    <div class="w-px h-10 bg-gradient-to-b from-transparent via-mocha-200 to-transparent opacity-30"></div>
    <p style="font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(160,84,21,0.5);">Scroll</p>
  </div>
</section>
