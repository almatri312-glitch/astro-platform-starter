---
const testimonials = [
  {
    name: 'Ahmed Al-Malki',
    role: 'Coffee Enthusiast, Riyadh',
    text: 'The best Yemeni coffee I have ever tasted. Deep, complex, with a lingering floral finish. Al-Khawlani has ruined me for every other coffee.',
    avatar: 'A',
  },
  {
    name: 'Sarah Mitchell',
    role: 'Specialty Coffee Blogger',
    text: "I've reviewed coffees from dozens of origins. Al-Khawlani stands alone. The wild blueberry note is unmistakable and the honey sweetness on the finish is unlike anything I've tried.",
    avatar: 'S',
  },
  {
    name: 'Rami Al-Qhtani',
    role: 'Café Owner',
    text: "We serve Mocha's Al-Khawlani as our featured pour-over. Customers ask for it by name. The consistency, freshness, and quality are unmatched.",
    avatar: 'R',
  },
];
---

<section class="py-32" style="background:#FAF7F2;">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-16 space-y-4">
      <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#9B7A50;">Customer Reviews</p>
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(2.2rem,4vw,3.2rem); font-weight:300; color:#1A0F00; line-height:1.1;">
        What Our <em style="font-style:italic; color:#8B6914;">Customers</em> Say
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="flex flex-col gap-6 p-8" style="background:#FFFFFF; border:1px solid rgba(26,15,0,0.06);">
          <!-- Stars -->
          <div class="flex gap-1">
            {Array(5).fill(0).map(() => (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="#8B6914">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p style="font-size:0.9rem; font-weight:300; color:#5C3D1E; line-height:1.8; flex:1;">{t.text}</p>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-4" style="border-top:1px solid rgba(26,15,0,0.06);">
            <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0"
              style="background:#1A0F00; color:#FAF7F2; font-size:0.75rem; font-weight:500;">
              {t.avatar}
            </div>
            <div>
              <p style="font-size:0.8rem; font-weight:500; color:#1A0F00;">{t.name}</p>
              <p style="font-size:0.65rem; color:#9B7A50; margin-top:1px;">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
