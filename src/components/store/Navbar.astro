---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Shop' },
  { href: '/#story', label: 'Our Story' },
  { href: '/#origins', label: 'Origins' },
];
const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-30 transition-all duration-500"
  style="background: rgba(250,247,242,0.95); border-bottom: 1px solid rgba(26,15,0,0.07);">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-16 sm:h-20">

      <!-- Logo -->
      <a href="/" class="no-underline flex flex-col">
        <span style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.4rem; font-weight:500; color:#1A0F00; letter-spacing:0.2em; line-height:1;">
          MOCHA
        </span>
        <span style="font-size:0.5rem; letter-spacing:0.35em; color:#9B7A50; font-weight:500; text-transform:uppercase; margin-top:2px;">
          Yemeni Coffee
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a href={link.href}
            class="no-underline transition-colors duration-200"
            style={`font-size: 0.65rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
              color: ${currentPath === link.href ? '#1A0F00' : '#9B7A50'};`}>
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right -->
      <div class="flex items-center gap-4">
        <!-- Cart -->
        <button id="open-cart-btn" class="relative p-1 transition-opacity hover:opacity-60" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A0F00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          <span id="cart-count-badge"
            class="absolute -top-1 -right-1 w-4 h-4 text-[9px] font-bold rounded-full flex items-center justify-center hidden"
            style="background:#1A0F00; color:#FAF7F2;">
          </span>
        </button>

        <!-- Mobile menu -->
        <button id="mobile-menu-btn" class="md:hidden p-1 hover:opacity-60 transition-opacity" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A0F00" stroke-width="1.5" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t" style="background:#FAF7F2; border-color:rgba(26,15,0,0.07);">
    <div class="px-6 py-6 flex flex-col gap-5">
      {navLinks.map((link) => (
        <a href={link.href} class="no-underline"
          style="font-size:0.65rem; font-weight:500; letter-spacing:0.2em; text-transform:uppercase; color:#1A0F00;">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<div class="h-16 sm:h-20"></div>

<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
  document.getElementById('open-cart-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mocha:open-cart'));
  });
  function updateBadge() {
    const badge = document.getElementById('cart-count-badge');
    if (!badge) return;
    try {
      const cart = JSON.parse(localStorage.getItem('mocha-cart') || '[]');
      const count = cart.reduce((s: number, i: { quantity: number }) => s + i.quantity, 0);
      badge.textContent = String(count);
      badge.classList.toggle('hidden', count === 0);
    } catch {}
  }
  updateBadge();
  window.addEventListener('mocha:cart', updateBadge);
</script>
