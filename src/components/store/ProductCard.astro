---
import type { Product } from '../../data/products';
import AddToCartButton from './AddToCartButton';

interface Props { product: Product; }
const { product } = Astro.props;
const roastBars = { Light: 1, Medium: 2, Dark: 3 };
const bars = roastBars[product.roast] ?? 2;
---

<article class="card-hover group relative flex flex-col" style="background:#FFFFFF; border:1px solid rgba(26,15,0,0.07);">

  <!-- Visual -->
  <a href={product.comingSoon ? '#' : `/products/${product.slug}`} class="block no-underline">
    <div class="relative overflow-hidden" style="aspect-ratio:1;">
      <div class="absolute inset-0 coffee-shimmer" style={`background:${product.gradient};`}></div>

      {product.comingSoon && (
        <div class="absolute inset-0 flex items-center justify-center" style="background:rgba(250,247,242,0.85);">
          <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#5C3D1E; font-weight:500;">Coming Soon</p>
        </div>
      )}

      {product.badge && !product.comingSoon && (
        <div class="absolute top-4 left-4">
          <span style="font-size:0.55rem; letter-spacing:0.2em; text-transform:uppercase; font-weight:600; color:#FAF7F2; background:#1A0F00; padding:4px 10px;">
            {product.badge}
          </span>
        </div>
      )}

      <div class="absolute bottom-4 right-4 flex gap-2">
        <span style="font-size:0.6rem; color:rgba(250,247,242,0.8); background:rgba(26,15,0,0.4); padding:3px 8px; backdrop-filter:blur(4px);">
          {product.weight}
        </span>
      </div>
    </div>
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5 gap-3">
    <!-- Name -->
    <div>
      <a href={product.comingSoon ? '#' : `/products/${product.slug}`} class="no-underline">
        <h3 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.2rem; font-weight:400; color:#1A0F00; line-height:1.2;">
          {product.name}
        </h3>
      </a>
      <p style="font-size:0.65rem; color:#9B7A50; margin-top:3px; letter-spacing:0.05em;">{product.origin}</p>
    </div>

    <!-- Roast -->
    <div class="flex items-center justify-between">
      <div class="flex gap-1">
        {[1,2,3].map((b) => (
          <div style={`width:20px; height:2px; background:${b <= bars ? '#1A0F00' : 'rgba(26,15,0,0.12)'};`}></div>
        ))}
      </div>
      <span style="font-size:0.6rem; letter-spacing:0.15em; text-transform:uppercase; color:#9B7A50;">{product.roast} Roast</span>
    </div>

    <!-- Flavor notes -->
    <div class="flex flex-wrap gap-1.5">
      {product.flavorNotes.slice(0,3).map((note) => (
        <span style="font-size:0.6rem; color:#5C3D1E; border:1px solid rgba(26,15,0,0.12); padding:2px 8px; letter-spacing:0.05em;">
          {note}
        </span>
      ))}
    </div>

    <!-- Price + CTA -->
    <div class="mt-auto pt-3" style="border-top:1px solid rgba(26,15,0,0.06);">
      {product.comingSoon ? (
        <p style="font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:#9B7A50; text-align:center; padding:0.75rem 0;">
          Notify Me
        </p>
      ) : (
        <div class="flex items-center justify-between gap-3">
          <div>
            {product.originalPrice && (
              <div style="font-size:0.75rem; color:#9B7A50; text-decoration:line-through;">${product.originalPrice}</div>
            )}
            <div style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.5rem; font-weight:300; color:#1A0F00; line-height:1;">
              ${product.price}
            </div>
          </div>
          <div class="flex-1 max-w-[130px]">
            <AddToCartButton client:load id={product.id} slug={product.slug} nameAr={product.name} price={product.price} gradient={product.gradient} />
          </div>
        </div>
      )}
    </div>
  </div>
</article>
