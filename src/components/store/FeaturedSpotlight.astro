---
import { getProductBySlug } from '../../data/products';
import AddToCartButton from './AddToCartButton';

const product = getProductBySlug('al-khawlani')!;
---

<section class="py-24 relative overflow-hidden">
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 50%, rgba(44,21,3,0.4) 0%, transparent 70%);"></div>
  <div class="absolute inset-0 opacity-10" style="background-image: url('/images/noise.png');"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-bold"
        style="border-color: rgba(200,150,62,0.3); color: #e8c47a; background: rgba(200,150,62,0.05);">
        ✦ Featured Product
      </div>
      <h2 class="font-black text-cream" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem);">
        Our Flagship Bean
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center rounded-3xl overflow-hidden"
      style="background: rgba(10,5,0,0.7); border: 1px solid rgba(200,150,62,0.2);">

      <!-- Visual side -->
      <div class="relative h-96 lg:h-auto lg:min-h-[480px] overflow-hidden"
        style="background: linear-gradient(145deg, #1a0800 0%, #5c2e08 40%, #c8963e 100%);">
        <div class="absolute inset-0 opacity-20" style="background-image: url('/images/noise.png');"></div>

        <!-- Glowing orb -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full blur-3xl opacity-30"
          style="background: radial-gradient(circle, #e8c47a 0%, transparent 70%);"></div>

        <div class="absolute inset-0 flex flex-col items-center justify-center gap-6 p-8">
          <!-- Coffee beans decoration -->
          <div class="relative float-anim">
            <svg viewBox="0 0 200 200" width="180" height="180" fill="none">
              <!-- Main bean -->
              <ellipse cx="100" cy="100" rx="55" ry="35" fill="#3d1e05" transform="rotate(-20 100 100)" opacity="0.9"/>
              <line x1="60" y1="100" x2="140" y2="100" stroke="#e8c47a" stroke-width="3" stroke-linecap="round" transform="rotate(-20 100 100)" opacity="0.6"/>

              <!-- Secondary beans -->
              <ellipse cx="50" cy="60" rx="30" ry="18" fill="#2c1503" transform="rotate(15 50 60)" opacity="0.8"/>
              <line x1="27" y1="60" x2="73" y2="60" stroke="#c8963e" stroke-width="2.5" stroke-linecap="round" transform="rotate(15 50 60)" opacity="0.5"/>

              <ellipse cx="150" cy="140" rx="30" ry="18" fill="#2c1503" transform="rotate(-10 150 140)" opacity="0.8"/>
              <line x1="127" y1="140" x2="173" y2="140" stroke="#c8963e" stroke-width="2.5" stroke-linecap="round" transform="rotate(-10 150 140)" opacity="0.5"/>

              <!-- Small accent beans -->
              <ellipse cx="155" cy="55" rx="18" ry="11" fill="#160b02" transform="rotate(30 155 55)" opacity="0.7"/>
              <line x1="141" y1="55" x2="169" y2="55" stroke="#e8c47a" stroke-width="1.5" stroke-linecap="round" transform="rotate(30 155 55)" opacity="0.4"/>

              <ellipse cx="45" cy="148" rx="18" ry="11" fill="#160b02" transform="rotate(-25 45 148)" opacity="0.7"/>
              <line x1="31" y1="148" x2="59" y2="148" stroke="#e8c47a" stroke-width="1.5" stroke-linecap="round" transform="rotate(-25 45 148)" opacity="0.4"/>
            </svg>
          </div>

          <!-- Product info pills -->
          <div class="flex flex-wrap gap-2 justify-center">
            {['Blueberry', 'Wild Cherry', 'Dark Chocolate', 'Honey'].map((note) => (
              <span class="px-3 py-1 rounded-full text-xs font-bold"
                style="background: rgba(10,5,0,0.7); color: #e8c47a; border: 1px solid rgba(200,150,62,0.3); backdrop-filter: blur(4px);">
                {note}
              </span>
            ))}
          </div>

          <!-- Badge -->
          <div class="absolute top-5 left-5">
            <span class="badge badge-gold text-[10px] tracking-wide shadow-lg">⭐ Best Seller</span>
          </div>
          <div class="absolute top-5 right-5 px-3 py-1.5 rounded-full font-black text-xs shadow-lg"
            style="background: rgba(10,5,0,0.8); color: #e8c47a; border: 1px solid rgba(200,150,62,0.3); backdrop-filter: blur(8px);">
            ▲ 2,200m
          </div>
        </div>
      </div>

      <!-- Text side -->
      <div class="p-8 lg:p-12 space-y-6">
        <div>
          <p class="text-mocha-300 text-xs font-bold tracking-widest uppercase mb-2">Single Origin · Khawlan, Yemen</p>
          <h3 class="font-black leading-tight text-cream" style="font-size: clamp(1.8rem, 3vw, 2.4rem);">
            Al-Khawlani<br/>
            <span class="text-gradient">Coffee</span>
          </h3>
        </div>

        <!-- Rating -->
        <div class="flex items-center gap-3">
          <div class="flex gap-1">
            {Array(5).fill(0).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#c8963e">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <span class="text-gold font-black text-sm">4.9</span>
          <span class="text-mocha-300 text-sm">(318 reviews)</span>
        </div>

        <p class="text-mocha-100 leading-relaxed" style="font-weight: 300;">
          The crown jewel of Yemeni coffee — grown in ancient highlands at over 2,000 meters. Hand-picked at peak ripeness and naturally processed, delivering an extraordinary cup with wild complexity: bright berry fruit, deep chocolate, and a lingering floral finish.
        </p>

        <!-- Quick specs -->
        <div class="grid grid-cols-2 gap-3">
          {[
            { label: 'Roast', value: 'Medium' },
            { label: 'Weight', value: '250g' },
            { label: 'Process', value: 'Natural' },
            { label: 'Origin', value: 'Khawlan' },
          ].map((spec) => (
            <div class="px-3 py-2.5 rounded-xl" style="background: rgba(44,21,3,0.5); border: 1px solid rgba(200,150,62,0.1);">
              <p class="text-mocha-300 text-[10px] font-bold uppercase tracking-wider">{spec.label}</p>
              <p class="text-cream font-bold text-sm mt-0.5">{spec.value}</p>
            </div>
          ))}
        </div>

        <!-- Price & CTA -->
        <div class="flex items-center gap-4 pt-2">
          <div>
            <p class="text-mocha-300 text-xs font-medium">Starting at</p>
            <p class="font-black text-3xl text-gold">$34.99 <span class="text-sm font-medium text-mocha-200">/ 250g</span></p>
          </div>
          <div class="flex flex-col gap-2 flex-1 max-w-[200px]">
            <AddToCartButton
              client:load
              id={product.id}
              slug={product.slug}
              nameAr={product.name}
              price={product.price}
              gradient={product.gradient}
            />
            <a href={`/products/${product.slug}`}
              class="btn btn-outline btn-sm no-underline text-center w-full">
              View Details
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
