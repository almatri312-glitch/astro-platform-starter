---
---

<section id="story" class="py-32 relative" style="background:#FAF7F2;">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-20 items-center">

      <!-- Image side -->
      <div class="relative">
        <div class="relative overflow-hidden" style="aspect-ratio:4/5; background:linear-gradient(145deg,#2c1503,#7a3d0a,#c8963e);">
          <div class="absolute inset-0 opacity-15" style="background-image:url('/images/noise.png');"></div>
          <div class="absolute inset-0 flex flex-col justify-end p-10">
            <div style="border-top:1px solid rgba(245,224,176,0.3); padding-top:1.5rem; margin-top:auto;">
              <p style="font-family:'Cormorant Garamond',Georgia,serif; font-size:3rem; font-weight:300; color:#F5E0B0; line-height:1;">Yemen</p>
              <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:rgba(200,150,62,0.7); margin-top:6px;">The Birthplace of Coffee</p>
            </div>
          </div>
        </div>

        <!-- Floating cards -->
        <div class="absolute -bottom-6 -right-6 px-5 py-4" style="background:#FFFFFF; border:1px solid rgba(26,15,0,0.07); box-shadow:0 8px 32px rgba(26,15,0,0.06);">
          <p style="font-family:'Cormorant Garamond',Georgia,serif; font-size:2rem; font-weight:300; color:#1A0F00; line-height:1;">100%</p>
          <p style="font-size:0.55rem; letter-spacing:0.2em; text-transform:uppercase; color:#9B7A50; margin-top:3px;">Natural & Organic</p>
        </div>
      </div>

      <!-- Text side -->
      <div class="space-y-8">
        <div>
          <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#9B7A50;">Our Story</p>
          <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(2.5rem,5vw,3.8rem); font-weight:300; color:#1A0F00; line-height:1.1; margin-top:0.75rem;">
            From Yemeni<br />
            <em style="font-style:italic; color:#8B6914;">Highlands</em> to Your Cup
          </h2>
        </div>

        <div class="space-y-5" style="font-size:0.95rem; font-weight:300; color:#5C3D1E; line-height:1.9;">
          <p>Mocha was born from a deep passion for Yemen's extraordinary coffee heritage. We are not just a store — we are a bridge between Yemeni mountain farmers and coffee lovers around the world.</p>
          <p>We work directly with local farmers in Khawlan, ensuring fair prices for growers and the freshest possible beans for you.</p>
          <p>Every bag is hand-selected, small-batch roasted, and shipped within days of roasting — so you always taste coffee at its absolute peak.</p>
        </div>

        <div style="border-top:1px solid rgba(26,15,0,0.08); padding-top:2rem;">
          <div class="grid grid-cols-2 gap-6">
            {[
              { icon: '◈', title: '100% Organic', desc: 'No pesticides or additives' },
              { icon: '◈', title: 'Fair Trade', desc: 'Fair wages for all farmers' },
              { icon: '◈', title: 'Small-Batch', desc: 'Roasted fresh daily' },
              { icon: '◈', title: 'Fast Delivery', desc: 'Ships within 24h of roast' },
            ].map((v) => (
              <div>
                <p style="font-size:0.6rem; letter-spacing:0.15em; text-transform:uppercase; color:#9B7A50; margin-bottom:4px;">{v.icon} {v.title}</p>
                <p style="font-size:0.85rem; font-weight:300; color:#5C3D1E;">{v.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
