---
const origins = [
  { name: 'Khawlan', nameAr: 'خولان', elevation: '2,200m', gradient: 'linear-gradient(145deg,#1a0800,#5c2e08,#c8963e)', active: true },
  { name: 'Haraz', nameAr: 'حراز', elevation: '2,500m', gradient: 'linear-gradient(145deg,#0a0500,#2c1503,#7a3d0a)', active: false },
  { name: 'Ibb', nameAr: 'إب', elevation: '1,800m', gradient: 'linear-gradient(145deg,#1a0c00,#4a2a08,#c8963e)', active: false },
  { name: 'Hadhramaut', nameAr: 'حضرموت', elevation: '1,200m', gradient: 'linear-gradient(145deg,#1a0800,#5c2e08,#d4a228)', active: false },
];
---

<section id="origins" class="py-32" style="background:#F2EDE4;">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-16 space-y-4">
      <p style="font-size:0.6rem; letter-spacing:0.3em; text-transform:uppercase; color:#9B7A50;">Origin Regions</p>
      <h2 style="font-family:'Cormorant Garamond',Georgia,serif; font-size:clamp(2.2rem,4vw,3.2rem); font-weight:300; color:#1A0F00; line-height:1.1;">
        Sourced from the <em style="font-style:italic; color:#8B6914;">Heart</em> of Yemen
      </h2>
      <p style="font-size:0.9rem; font-weight:300; color:#5C3D1E; max-width:36rem; margin:0 auto; line-height:1.8;">
        Each Yemeni region imparts a distinct character shaped by altitude, climate, and centuries of farming tradition.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {origins.map((o) => (
        <div class="group relative overflow-hidden card-hover" style={`aspect-ratio:3/4; background:${o.gradient}; ${o.active ? 'border:1px solid rgba(200,150,62,0.4);' : 'opacity:0.75;'}`}>
          <div class="absolute inset-0 opacity-15" style="background-image:url('/images/noise.png');"></div>

          {o.active && (
            <div class="absolute top-4 left-4">
              <span style="font-size:0.55rem; letter-spacing:0.2em; text-transform:uppercase; font-weight:600; color:#FAF7F2; background:rgba(26,15,0,0.6); padding:3px 10px; backdrop-filter:blur(4px);">
                Available Now
              </span>
            </div>
          )}

          <div class="absolute inset-0 flex flex-col justify-end p-6">
            <p style="font-family:'Cormorant Garamond',Georgia,serif; font-size:1.8rem; font-weight:300; color:#F5E0B0; line-height:1;">{o.name}</p>
            <p style="font-size:0.65rem; color:rgba(245,224,176,0.6); margin-top:2px; letter-spacing:0.05em;">{o.nameAr} · ▲ {o.elevation}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
